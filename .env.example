# ============================================================================
# AI-OPC Company OS — biến môi trường mẫu.
# Copy file này thành .env (root) và .env riêng trong services/api nếu cần,
# rồi chỉnh theo môi trường thực tế của bạn.
# ============================================================================

# ---- Core Engine (services/api) ------------------------------------------
PORT=8000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# Chọn 1 trong 3: postgresql | sqlite | sqlserver
DB_PROVIDER=postgresql

# --- Nếu DB_PROVIDER=postgresql (mặc định, server riêng / đồng bộ đa thiết bị)
DATABASE_URL="postgresql://founder:supersecretpassword@localhost:5432/company_os"

# --- Nếu DB_PROVIDER=sqlite (chạy hoàn toàn local, không cần Docker/server)
# DATABASE_URL="file:./data/company_os.db"

# --- Nếu DB_PROVIDER=sqlserver (doanh nghiệp đã có hạ tầng MSSQL on-prem)
# DATABASE_URL="sqlserver://user:password@localhost:1433;database=company_os;encrypt=true"

# ---- Multi-Provider LLM Gateway (Gemini / OpenAI / Anthropic / Local AI) ---
# Hệ thống tự động phát hiện provider dựa trên API key hoặc Local URL trong file:
#   1. CUSTOM_LLM_URL    -> Local LLM / OpenAI Compatible (Ollama, LM Studio, vLLM)
#   2. GEMINI_API_KEY    -> Google Gemini (mặc định: gemini-3.7-flash kèm fallback)
#   3. OPENAI_API_KEY    -> OpenAI        (mặc định: gpt-4o)
#   4. ANTHROPIC_API_KEY -> Anthropic     (mặc định: claude-3-5-sonnet-20241022)
# Chỉ cần điền ít nhất 1 phương thức (KHÔNG commit key thật vào git):
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Local LLM / Custom OpenAI-compatible URL (Ollama, LM Studio, vLLM) ----
# Ví dụ Ollama:     http://localhost:11434/v1
# Ví dụ LM Studio:  http://localhost:1234/v1
# Ví dụ vLLM:       http://localhost:8080/v1
# CUSTOM_LLM_URL=http://localhost:11434/v1

# Model dùng cho AI-COO Orchestrator (phân rã /goal thành sub-tasks).
# Mặc định theo provider phát hiện được; ví dụ: gemini-2.5-pro, gpt-4o.
# ORCHESTRATOR_MODEL=
# CUSTOM_LLM_API_KEY=local-key
# CUSTOM_LLM_MODEL=llama3

# (Tuỳ chọn) Ép dùng cố định 1 provider nếu có nhiều key: gemini | openai | anthropic | custom
# LLM_PROVIDER=custom

# (Tuỳ chọn) Ghi đè model mặc định của provider
# ORCHESTRATOR_MODEL=gemini-3.7-flash

# Agent Worker
AGENT_WORKER_POLL_MS=5000

# Model Token Cost (USD per 1 Million Tokens)
MODEL_INPUT_COST_PER_MTOK=3
MODEL_OUTPUT_COST_PER_MTOK=15

# Retry cho lỗi transient (429 rate limit, 500, 502, 503, 504, timeout, network...)
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_MS=1000
LLM_RETRY_MAX_MS=8000

# ---- Web (apps/web) --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---- Vector Store (tuỳ chọn, Company Memory ngữ nghĩa) ---------------------
# CHROMA_SERVER_HOST=localhost
# CHROMA_SERVER_HTTP_PORT=8001

# ---- External Data Sources (Database bên ngoài cho Agent thao tác) --------
# Ví dụ cấu hình SQL Server cho nghiệp vụ khách sạn 'hotel_dbs':
DATASOURCE_HOTEL_DBS_ENGINE=sqlserver
DATASOURCE_HOTEL_DBS_HOST=127.0.0.1
DATASOURCE_HOTEL_DBS_PORT=1433
DATASOURCE_HOTEL_DBS_DATABASE=hotel_dbs
DATASOURCE_HOTEL_DBS_USER=sa
DATASOURCE_HOTEL_DBS_PASSWORD=your_password_here
DATASOURCE_HOTEL_DBS_ENCRYPT=false
DATASOURCE_HOTEL_DBS_TRUST_CERT=true

# ---- Telegram Notification & 2-Way Control ---------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_POLL_MS=2000

# ---- Zalo Notification & 2-Way Control (Zalo Auth via zca-js) --------------
# ZALO_NOTIFY_PHONE=
# ZALO_NOTIFY_GROUP_ID=
# Danh sách Zalo User ID của Founder/Admin được phép ra lệnh qua Zalo (phân tách bằng dấu phẩy):
# ZALO_ADMIN_IDS=1234567890123456789

# ---- Zalo Bot Platform (bot.zaloplatforms.com) -----------------------------
# ZALO_BOT_TOKEN=
# ZALO_CHAT_ID=
# ZALO_POLL_MS=2000



