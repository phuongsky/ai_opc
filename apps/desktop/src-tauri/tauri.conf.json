{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-OPC Company OS",
  "version": "0.1.0",
  "identifier": "com.aiopc.companyos",
  "build": {
    "beforeBuildCommand": "pnpm --filter @ai-opc/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "AI-OPC — Executive Cockpit",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: asset: data: blob:; connect-src 'self' http://localhost:8000 ws://localhost:8000 http://127.0.0.1:8000 ws://127.0.0.1:8000 https: wss:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; img-src 'self' data: blob: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": [
      "binaries/api-server"
    ],
    "resources": [
      "binaries/query_engine-windows.dll.node",
      "binaries/data/company_os.db"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
