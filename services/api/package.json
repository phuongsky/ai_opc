{
  "name": "@ai-opc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:mssql": "cross-env DB_PROVIDER=sqlserver prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "bootstrap:founder": "tsx src/db/bootstrapFounder.ts"
  },
  "dependencies": {
    "@ai-opc/shared": "workspace:*",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.3",
    "nodemailer": "^10.0.10",
    "otplib": "^12.0.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zca-js": "^2.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
